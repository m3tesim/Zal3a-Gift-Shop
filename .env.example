# Used once, when the first admin is created by `npm run setup`.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed.
ADMIN_EMAIL=admin@zal3a.local
ADMIN_PASSWORD=admin

# Where the SQLite database and uploaded images live (default: ./data)
# DATA_DIR=/var/lib/zal3a

# Public address of the shop, used in email links and social share previews
# SITE_URL=https://zal3a.com

# Email (any SMTP provider). Without these, emails are saved to the admin outbox but not sent.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=you@zal3a.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM="zal3a <hello@zal3a.com>"
